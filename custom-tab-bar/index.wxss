.tab-bar { position: fixed; z-index: 80; right: 0; bottom: 0; left: 0; display: flex; min-height: 104rpx; padding: 10rpx 24rpx calc(8rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e6ebe8; background: rgba(255,255,255,.97); box-shadow: 0 -12rpx 32rpx rgba(21,54,42,.04); transition: transform 180ms cubic-bezier(.23,1,.32,1), opacity 140ms ease; }
.tab-bar.hidden { opacity: 0; pointer-events: none; transform: translateY(100%); }
.tab-item { position: relative; display: flex; flex: 1; min-width: 0; min-height: 88rpx; flex-direction: column; align-items: center; justify-content: center; color: #7b8580; font-size: 22rpx; line-height: 1; transition: transform 140ms cubic-bezier(.23,1,.32,1), color 140ms ease; }
.tab-item:active { transform: scale(.96); }
.tab-item.active { color: #174e3e; font-weight: 650; }
.tab-item.active::before { position: absolute; top: 0; width: 70rpx; height: 54rpx; border-radius: 14rpx; background: #e3f1eb; content: ''; }
.tab-icon { position: relative; z-index: 1; display: block; width: 44rpx; height: 44rpx; flex: 0 0 44rpx; margin-bottom: 7rpx; }
.tab-item text { height: 28rpx; line-height: 28rpx; }
