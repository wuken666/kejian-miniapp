page { background: #fff; }
.students-page { background: #fff; padding-top: 24rpx; }
.student-add-float { position: fixed; z-index: 20; right: 38rpx; bottom: calc(136rpx + env(safe-area-inset-bottom)); display: flex; width: 96rpx; height: 96rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(255,255,255,.35); border-radius: 50%; background: #174e3e; color: #fff; box-shadow: 0 10rpx 24rpx rgba(21, 63, 47, .2); }
.students-page .page-title { font-size: 40rpx; }
.student-search { display: block; box-sizing: border-box; width: 100%; height: 84rpx; margin-bottom: 22rpx; padding: 0 24rpx; border-radius: 999rpx; background: #f1f4f2; color: #213a2c; font-size: 25rpx; }
.student-list-count { display: block; padding: 28rpx 0 10rpx; color: #87938a; font-size: 23rpx; }
.student-directory-row { display: flex; min-height: 136rpx; align-items: center; gap: 20rpx; border-bottom: 1rpx solid #e8ece9; }
.directory-avatar { display: flex; width: 76rpx; height: 76rpx; flex: 0 0 76rpx; align-items: center; justify-content: center; border-radius: 50%; background: #e7f1eb; color: #34634d; font-size: 25rpx; font-weight: 650; }
.directory-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 10rpx; }
.directory-copy text:first-child { font-size: 29rpx; font-weight: 650; }
.directory-copy text:last-child { color: #8a948d; font-size: 23rpx; }
.directory-lessons { display: flex; align-items: flex-end; flex-direction: column; gap: 5rpx; }
.directory-lessons text:first-child { font-size: 28rpx; font-weight: 650; color: #3b6c53; }
.directory-lessons text:last-child { font-size: 20rpx; color: #949e97; }
.student-directory-row > image { width: 28rpx; height: 28rpx; }
.student-search-empty { display: block; padding: 70rpx 0; text-align: center; color: #8a958e; font-size: 25rpx; }
.directory-back { display: flex; align-items: center; gap: 8rpx; margin-bottom: 20rpx; color: #6d8074; font-size: 25rpx; }
.directory-back image { width: 32rpx; height: 32rpx; transform: rotate(180deg); }
.students-page .student-detail { box-shadow: none; background: #f6f8f6; border-color: #e6ede7; border-radius: 8rpx; }
.directory-copy .directory-meta { color: #8a948d; font-size: 23rpx; }
.directory-address { display: block; overflow-wrap: anywhere; white-space: normal; line-height: 1.5; }
.student-directory-row { padding-top: 20rpx; padding-bottom: 20rpx; }
.detail-address { display: flex; flex-direction: column; gap: 10rpx; padding-bottom: 24rpx; }
.address-input { height: 112rpx; min-height: 112rpx; }
.lesson-datetime { display: flex; flex: 0 0 150rpx; width: 150rpx; flex-direction: column; gap: 7rpx; align-self: stretch; justify-content: center; padding-right: 14rpx; border-right: 1rpx solid #e4ebe6; }
.lesson-year { font-size: 21rpx; color: #87948b; line-height: 1.4; }
.lesson-day { font-size: 25rpx; font-weight: 700; color: #243b2e; line-height: 1.5; white-space: nowrap; }
.lesson-start-time { font-size: 26rpx; font-weight: 650; color: #386e56; line-height: 1.4; }
.lesson-start-time.time-unknown { font-size: 20rpx; font-weight: 400; color: #8a948d; white-space: nowrap; }
.student-status-tabs { display: flex; width: 100%; gap: 8rpx; padding: 6rpx; border-radius: 8rpx; background: #f0f3f1; }
.student-status-tab { display: flex; flex: 1; min-width: 0; height: 72rpx; align-items: center; justify-content: center; gap: 12rpx; border-radius: 6rpx; color: #78867d; font-size: 26rpx; font-weight: 600; }
.student-status-tab.selected { background: #e0eee7; color: #245e4e; }
.student-graduated-label { display: block; margin-top: 8rpx; color: #8a7867; font-size: 23rpx; }
.student-graduation-button { display: flex; width: 100%; min-height: 84rpx; gap: 14rpx; justify-content: center; align-items: center; margin-top: 24rpx; border: 1rpx solid #d6e4dc; border-radius: 8rpx; background: #fff; color: #245e4e; font-size: 26rpx; font-weight: 600; }
.student-graduation-button image { width: 32rpx; height: 32rpx; }
.student-graduation-button.graduation-red { color: #b84343; border-color: #edcece; background: #fff5f5; }
.student-graduation-button[aria-disabled="true"] { opacity: .5; }
