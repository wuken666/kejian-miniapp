in-top:8rpx;font-size:26rpx;line-height:1.55}.detail-value.muted{color:#8a948f}.detail-value.count{font-size:32rpx;font-weight:700}.lesson-button{display:grid;grid-template-columns:30rpx minmax(0,1fr) 24rpx;align-items:center;width:100%;min-height:88rpx;margin-top:26rpx;padding:0 22rpx;border-radius:13rpx;background:#174e3e;color:#fff;font-size:26rpx;font-weight:700;text-align:left}.lesson-button > text{font-size:26rpx;font-weight:700}.loading-state.compact,.empty-state.compact{padding:46rpx 24rpx}.lesson-list{overflow:hidden}.lesson-row{display:grid;grid-template-columns:12rpx minmax(0,1fr) 28rpx;align-items:center;width:100%;padding:25rpx 23rpx;border-bottom:1rpx solid #edf1ee;background:#fff;text-align:left}.lesson-row:last-child{border-bottom:0}.lesson-date-mark{width:10rpx;height:10rpx;border-radius:50%;background:#4a8d76;box-shadow:0 0 0 8rpx #e5f1ec}.lesson-copy{display:flex;min-width:0;margin-left:16rpx;flex-direction:column}.lesson-heading{display:flex;align-items:center;gap:12rpx}.lesson-title{min-width:0;flex:1;overflow:hidden;font-size:27rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.lesson-summary{display:-webkit-box;margin-top:10rpx;overflow:hidden;color:#58655f;font-size:24rpx;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.lesson-date{margin-top:10rpx;color:#8a938f;font-size:21rpx}.lesson-arrow{color:#7d8b84;font-size:38rpx}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.picker-value{display:flex;align-items:center}.delete-student{width:100%;margin-top:20rpx}.lesson-sheet{max-height:92vh}@keyframes detail-enter{from{opacity:0;transform:translateX(14rpx)}to{opacity:1;transform:translateX(0)}}@media(prefers-reduced-motion:reduce){.detail-enter{animation:none}}

.empty-primary-action{display:grid;width:100%;min-height:94rpx;padding:0 18rpx;grid-template-columns:56rpx minmax(0,1fr) 56rpx;align-items:center;border-radius:14rpx;background:#174e3e;color:#fff;font-size:28rpx;font-weight:700}.empty-primary-action>text{min-width:0;text-align:center}.empty-action-side{display:flex;width:56rpx;height:56rpx;align-items:center;justify-content:center}.empty-action-side:first-child{border-radius:12rpx;background:rgba(255,255,255,.1);color:#a6e7ce}.empty-action-side:last-child{color:#d8ede5}

/* 学生横向切换后让档案内容轻量入场，减少静态页面的跳变感。 */
.detail-swap{animation:detail-swap 240ms cubic-bezier(.23,1,.32,1) both}
@keyframes detail-swap{from{opacity:0;transform:translateX(18rpx) scale(.99)}to{opacity:1;transform:translateX(0) scale(1)}}
@media(prefers-reduced-motion:reduce){.detail-swap{animation:none}}

/* 学生 Tab 选中时平滑抬升，和档案内容入场保持同一条动线。 */
.student-tab {
  transition: transform 180ms cubic-bezier(.23,1,.32,1), background-color 180ms ease-out, border-color 180ms ease-out, color 180ms ease-out, box-shadow 180ms ease-out;
}

@media (prefers-reduced-motion: reduce) {
  .student-tab {
    transition: none;
  }
}

/* 避免原生 button 和 grid 在不同基础库下产生拉伸。 */
