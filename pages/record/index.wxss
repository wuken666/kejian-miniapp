.paste-panel { margin-top: 18rpx; padding: 20rpx; border: 1rpx solid #d9e2dd; border-radius: 14rpx; background: #fff; }.paste-panel textarea { width: 100%; min-height: 180rpx; color: #21332a; font-size: 27rpx; line-height: 1.6; }.secondary-button, .primary-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 86rpx; border-radius: 12rpx; font-size: 27rpx; font-weight: 720; }.secondary-button { margin-top: 18rpx; background: #e3f0eb; color: #17533f; }.primary-button { margin-top: 24rpx; background: #174f40; color: #fff; }
.empty-card { margin-top: 32rpx; padding: 34rpx; border-radius: 16rpx; background: #fff; border: 1rpx solid #dbe4df; }.empty-title { display: block; font-size: 32rpx; font-weight: 760; }.empty-copy { display: block; margin-top: 12rpx; color: #718078; font-size: 25rpx; line-height: 1.6; }
.recording-content { display: flex; flex-direction: column; align-items: center; padding: 54rpx 34rpx 0; }
.mic-stage { position: relative; display: flex; align-items: center; justify-content: center; width: 250rpx; height: 250rpx; }
.mic-ring { position: absolute; border-radius: 50%; border: 2rpx solid rgba(216,245,235,.28); }.ring-one { inset: 22rpx; }.ring-two { inset: 0; opacity: .18; }
.mic-core { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; width: 178rpx; height: 178rpx; border-radius: 50%; background: #2d8b70; color: #fff; box-shadow: 0 0 0 18rpx rgba(68,154,128,.12); }
.mic-core text { font-size: 54rpx; }.mic-stage.recording .ring-one { animation: pulse 2.1s infinite ease-out; }.mic-stage.interrupted .mic-core { background: #5e776e; }
.recording-title { max-width: 620rpx; margin-top: 36rpx; font-size: 36rpx; font-weight: 780; line-height: 1.35; text-align: center; }.wave { display: flex; align-items: center; gap: 8rpx; height: 60rpx; margin-top: 16rpx; }.wave text { width: 8rpx; border-radius: 8rpx; background: #b9dbcf; animation: wave 900ms infinite ease-in-out alternate; }.wave text:nth-child(1),.wave text:nth-child(6){height:24rpx}.wave text:nth-child(2),.wave text:nth-child(5){height:48rpx;animation-delay:100ms}.wave text:nth-child(3),.wave text:nth-child(4){height:60rpx;animation-delay:200ms}.recovery-indicator{display:flex;align-items:center;justify-content:center;gap:10rpx;height:60rpx;margin-top:16rpx}.recovery-indicator text{width:12rpx;height:12rpx;border-radius:50%;background:#b9dbcf;animation:recovery-dot 900ms cubic-bezier(.23,1,.32,1) infinite}.recovery-indicator text:nth-child(2){animation-delay:120ms}.recovery-indicator text:nth-child(3){animation-delay:240ms}.recording-time { margin-top: 2rpx; color: #d3e9e1; font-size: 62rpx; font-weight: 760; font-variant-numeric: tabular-nums; }.foreground-note { margin-top: 10rpx; color: #9fc4b9; font-size: 22rpx; line-height: 1.45; text-align: center; }.storage-status { display: flex; align-items: center; justify-content: center; gap: 10rpx; min-height: 38rpx; margin-top: 12rpx; color: #b9d8ce; font-size: 22rpx; }.storage-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; }.storage-status.syncing .storage-dot { animation: storage-pulse 1.2s ease-in-out infinite; }.storage-status.saved { color: #cce8dd; }
.audio-health-banner { display: flex; width: 100%; box-sizing: border-box; margin-top: 22rpx; padding: 18rpx 20rpx; align-items: center; gap: 14rpx; border: 1rpx solid rgba(250, 215, 154, .35); border-radius: 12rpx; background: rgba(119, 72, 16, .34); color: #ffe7b8; font-size: 23rpx; line-height: 1.45; }.audio-health-banner.storage-warning { border-color: rgba(255, 205, 130, .42); background: rgba(105, 59, 8, .4); }.audio-health-icon { display: flex; width: 34rpx; height: 34rpx; flex: 0 0 34rpx; align-items: center; justify-content: center; }
.transcript-panel { width: 100%; height: 330rpx; margin-top: 34rpx; border: 1rpx solid rgba(211,239,230,.24); border-radius: 16rpx; background: rgba(3,43,33,.2); }
  .transcript-heading { position: sticky; top: 0; display: flex; justify-content: space-between; padding: 24rpx 26rpx; border-bottom: 1rpx solid rgba(211,239,230,.16); background: #104638; font-size: 23rpx; font-weight: 700; }.transcript-heading text:last-child { color: #9ccabd; font-weight: 550; }.transcript-body { display: flex; flex-direction: column; gap: 14rpx; padding: 24rpx 26rpx 34rpx; color: #e4f6ef; font-size: 27rpx; line-height: 1.75; white-space: pre-wrap; }.transcript-bottom { width: 1rpx; height: 1rpx; }.partial-line { color: #a8cfc3; }.transcript-placeholder { color: #82aa9e; }
.error-banner, .notice-banner { width: 100%; box-sizing: border-box; margin-top: 22rpx; padding: 20rpx 22rpx; border-radius: 12rpx; font-size: 24rpx; line-height: 1.5; }.error-banner { border: 1rpx solid #efb7b0; background: #fde7e4; color: #a43730; }.is-recording .error-banner { border-color: rgba(255,196,187,.38); background: rgba(165,55,47,.24); color: #ffd9d3; }.error-banner.light { margin: 24rpx 0 0; }.notice-banner { border: 1rpx solid #d7e7df; background: #eef5f2; color: #52675e; }.saving-banner { display: flex; align-items: center; justify-content: center; gap: 14rpx; margin-top: 22rpx; color: #c5e2d8; font-size: 24rpx; }.spinner { width: 26rpx; height: 26rpx; border: 3rpx solid rgba(220,247,238,.28); border-top-color: #d9f4eb; border-radius: 50%; animation: spin 700ms linear infinite; }
.setup-error { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }.retry-button { min-height: 58rpx; padding: 0 18rpx; border: 1rpx solid #d7a650; border-radius: 10rpx; color: #79511b; font-size: 22rpx; font-weight: 700; white-space: nowrap; }
.recording-actions { display: flex; width: 100%; margin-top: 28rpx; flex-direction: column; gap: 16rpx; }
.recording-actions.is-disabled { pointer-events: none; opacity: .52; }
.pause-button,
.finish-button { display: flex; width: 100%; min-height: 94rpx; align-items: center; justify-content: center; gap: 15rpx; border-radius: 14rpx; font-size: 28rpx; font-weight: 720; }
.pause-button { border: 2rpx solid rgba(226,246,239,.66); background: rgba(255,255,255,.08); color: #effbf7; }
.finish-button { background: #d9f0e8; color: #124c3a; box-shadow: 0 10rpx 24rpx rgba(4,39,29,.15); }
.delete-button { display: flex; min-height: 66rpx; margin-top: 8rpx; padding: 0 24rpx; align-self: center; align-items: center; justify-content: center; gap: 12rpx; border-radius: 10rpx; background: transparent; color: #efaaa0; font-size: 23rpx; }
.review-heading { display: flex; align-items: center; gap: 18rpx; }.ai-mark { display: flex; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; border-radius: 14rpx; background: #e0f1eb; color: #1b6a52; font-size: 23rpx; font-weight: 800; }.review-note { display: block; margin-top: 20rpx; color: #718179; font-size: 25rpx; line-height: 1.6; }
.raw-toggle { display: flex; justify-content: space-between; width: 100%; margin-top: 24rpx; padding: 24rpx; border: 1rpx solid #dce5e0; border-radius: 12rpx; background: #fff; color: #263b31; font-size: 25rpx; font-weight: 700; }.raw-toggle text:last-child { color: #2a725b; font-weight: 600; }.raw-transcript { margin-top: 10rpx; padding: 24rpx; border-radius: 12rpx; background: #edf2ef; color: #53655c; font-size: 24rpx; line-height: 1.7; white-space: pre-wrap; }
.review-form { margin-top: 24rpx; padding: 26rpx; border: 1rpx solid #dce5e0; border-radius: 16rpx; background: #fff; }.field-group { position: relative; margin-top: 26rpx; }.field-group:first-child { margin-top: 0; }.field-label { display: block; color: #52655b; font-size: 23rpx; font-weight: 700; }.field-label-row { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }.field-label-actions { display: flex; min-width: 0; align-items: center; gap: 8rpx; }.field-optional { color: #8b9893; font-size: 22rpx; }.inline-action { flex: 0 0 auto; padding: 8rpx 14rpx; border-radius: 8rpx; background: #edf5f1; color: #286c57; font-size: 21rpx; }.field-group input, .field-group textarea, .picker-value { width: 100%; box-sizing: border-box; margin-top: 10rpx; padding: 20rpx; border: 1rpx solid #d8e1dc; border-radius: 11rpx; background: #fbfcfb; color: #17271f; font-size: 27rpx; line-height: 1.6; }.field-group textarea { min-height: 150rpx; }.field-group.missing textarea { border-color: #d9a952; background: #fffbf1; }.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.field-group.compact { min-width: 0; }.input-unit { position: absolute; right: 18rpx; bottom: 21rpx; color: #79877f; font-size: 22rpx; }.field-group.compact input { padding-right: 72rpx; }
.generate-button { display: flex; align-items: center; justify-content: center; gap: 12rpx; width: 100%; height: 96rpx; margin-top: 26rpx; border-radius: 14rpx; background: #174f40; color: #fff; font-size: 29rpx; font-weight: 760; }.ai-disclaimer { display: block; margin-top: 14rpx; color: #7d8c84; text-align: center; font-size: 21rpx; }
.pressable { transition: transform 140ms cubic-bezier(.23,1,.32,1), opacity 140ms ease; }.pressable:active { transform: scale(.97); opacity: .86; }.pressable[disabled] { opacity: .48; }
.page-enter { animation: page-enter 200ms cubic-bezier(.23,1,.32,1) both; }
@keyframes page-enter { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes pulse { 0% { transform: scale(.94); opacity: .2; } 70% { transform: scale(1.14); opacity: .02; } 100% { transform: scale(1.14); opacity: 0; } }
@keyframes wave { from { transform: scaleY(.55); opacity: .55; } to { transform: scaleY(1); opacity: 1; } }
@keyframes recovery-dot { 0%,100% { transform: translateY(0); opacity: .45; } 45% { transform: translateY(-10rpx); opacity: 1; } }
@keyframes status-pulse { 0%,100% { opacity: .62; } 50% { opacity: 1; } }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes storage-pulse { 50% { opacity: .35; transform: scale(.72); } }
@keyframes loading { from { transform: translateY(0); opacity: .4; } to { transform: translateY(-10rpx); opacity: 1; } }

/* 使用 flex 和固定伸缩约束，防止模拟器将三个辅助入口排成两列并溢出。 */
.student-tabs-inner{display:inline-flex;width:auto}.record-hero{width:100%}.hero-icon{flex:0 0 84rpx}.record-primary{width:100%}.record-primary.is-loading{opacity:.82}.record-primary>text{min-width:0}.assist-grid{display:flex;width:100%;gap:14rpx}.assist-card{width:calc((100% - 28rpx)/3);min-width:0;max-width:none;flex:1 1 0}

@media (prefers-reduced-motion: reduce) {
  .page-enter,
  .mic-stage.recording .ring-one,
  .status-dot.active,
  .wave text,
  .recovery-indicator text,
  .spinner,
  .loading-state text {
    animation: none;
  }
}
.record-page:not(.is-recording) { background: #fff; }
