.hero-copy { display: flex; flex-direction: column; gap: 5rpx; }.hero-label { color: #b8d8ce; font-size: 22rpx; }.hero-title { font-size: 34rpx; font-weight: 760; }
.hero-description { display: block; margin-top: 22rpx; color: #c8dfd7; font-size: 25rpx; line-height: 1.65; }
