.button-mic { font-size: 23rpx; }.output-flow { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 20rpx; color: #a9cabf; font-size: 21rpx; }.flow-arrow{width:10rpx;height:10rpx;border-top:2rpx solid currentColor;border-right:2rpx solid currentColor;transform:rotate(45deg)}
.assist-section { margin-top: 34rpx; }.section-heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18rpx; }.section-title { font-size: 29rpx; font-weight: 750; }.section-note { color: #839188; font-size: 22rpx; }
