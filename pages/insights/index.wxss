page { background: #fff; }
.insights-page { background: #fff; padding-top: 24rpx; }
.insight-view-tabs { display: flex; align-items: center; gap: 36rpx; margin-bottom: 16rpx; }
.insight-view-tabs > view { padding: 8rpx 0; color: #7b8580; font-size: 38rpx; font-weight: 600; }
.insight-view-tabs > view.active { color: #1d3228; font-weight: 750; }
.insight-updated { display: block; margin-bottom: 28rpx; color: #829087; font-size: 23rpx; }
.income-metrics .metric-value { font-size: 40rpx; overflow-wrap: anywhere; }
.income-metrics > view { min-width: 0; min-height: 154rpx; }
.income-metrics .metric-unit { display: inline-block; }
.income-note, .income-warning { display: block; margin: 12rpx 0 22rpx; font-size: 23rpx; line-height: 1.6; color: #7c8981; }
.income-warning { color: #a16a38; }
.income-chart-unit { font-size: 22rpx; color: #7c8981; }
.metric-caption { display: flex; align-items: center; gap: 6rpx; margin-bottom: 14rpx; }
.metric-caption .metric-label { margin-bottom: 0; }
.metric-info { display: flex; width: 36rpx; height: 36rpx; flex: 0 0 36rpx; align-items: center; justify-content: center; }
.metric-info image { width: 25rpx; height: 25rpx; }
.period-tabs, .chart-tabs { display: flex; padding: 6rpx; background: #f0f3f1; border-radius: 8rpx; }
.period-tab { flex: 1; text-align: center; padding: 18rpx 0; color: #768078; font-size: 26rpx; font-weight: 650; }
.period-tab.active, .chart-tabs .active { background: #dfeee7; color: #245e4e; border-radius: 6rpx; }
.period-navigation { display: flex; align-items: center; justify-content: space-between; margin: 18rpx 0 30rpx; }
.period-navigation > view, .month-controls > view { display: flex; width: 60rpx; height: 60rpx; align-items: center; justify-content: center; }
.period-navigation image, .month-controls image { width: 28rpx; height: 28rpx; }
.back { transform: rotate(180deg); }
.period-navigation > text { color: #6e7a73; font-size: 23rpx; }
.metrics-grid { display: flex; flex-wrap: wrap; gap: 32rpx 0; margin-bottom: 40rpx; }
.metrics-grid > view { width: 50%; padding: 0 12rpx 20rpx 0; border-bottom: 2rpx solid #e3ece7; }
.metric-label { display: block; color: #758079; font-size: 24rpx; margin-bottom: 14rpx; }
.metric-value { font-size: 52rpx; font-weight: 720; color: #1d3228; }
.metric-unit { margin-left: 8rpx; color: #7c867f; font-size: 23rpx; }
.insight-section { padding: 30rpx 0; border-top: 1rpx solid #e5ebe7; }
.insight-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 22rpx; }
.insight-section-heading > text { font-size: 30rpx; font-weight: 700; }
.chart-tabs > view { padding: 10rpx 18rpx; font-size: 22rpx; color: #6a766e; }
.distribution-summary { display: flex; flex-wrap: wrap; gap: 18rpx; color: #78847c; font-size: 22rpx; }
.month-controls { display: flex; align-items: center; justify-content: center; gap: 24rpx; margin: 18rpx 0; font-size: 28rpx; font-weight: 700; }
.insight-weekdays { display: flex; margin-bottom: 10rpx; color: #8b958e; font-size: 22rpx; }
.insight-weekdays text { width: 14.2857%; text-align: center; }
.insight-calendar { display: flex; flex-wrap: wrap; }
.insight-day { display: flex; width: 14.2857%; height: 88rpx; flex: 0 0 14.2857%; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; }
.insight-day > .insight-day-number { display: flex; box-sizing: border-box; width: 56rpx; height: 56rpx; align-items: center; justify-content: center; border: 2rpx solid transparent; border-radius: 50%; color: #26352d; font-size: 27rpx; font-weight: 520; }
.insight-day > text:last-child { font-size: 18rpx; color: #779282; }
.insight-day.muted { opacity: .25; }
.insight-day.today:not(.selected) .insight-day-number { border-color: #c97555; color: #a64b2f; }
.insight-day.selected .insight-day-number { background: #b54f32; color: #fff; font-weight: 700; }
.selected-day-summary { display: flex; flex-direction: column; gap: 10rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #edf0ed; }
.selected-day-summary > text:first-child { font-size: 26rpx; font-weight: 650; }
.selected-day-summary > text:nth-child(2) { color: #7d8880; font-size: 23rpx; }
.selected-day-summary .section-link { padding: 8rpx 0; }
.chart-unit { display: block; margin-top: 24rpx; color: #809086; font-size: 21rpx; }
.teaching-chart { display: block; width: 100%; height: 380rpx; }
.chart-empty, .quiet-empty { display: block; padding: 20rpx 0; color: #89958d; font-size: 24rpx; }
.attendance-track, .subject-track { height: 10rpx; overflow: hidden; background: #edf1ee; border-radius: 6rpx; }
.attendance-track > view, .subject-track > view { height: 100%; background: #3f8b72; }
.status-columns { display: flex; margin-top: 26rpx; }
.status-columns > view { display: flex; width: 33.33%; flex-direction: column; gap: 12rpx; padding-left: 16rpx; border-left: 2rpx solid #e9eeea; }
.status-columns > view:first-child { padding-left: 0; border: 0; }
.status-columns > view > text:first-child { color: #7b877e; font-size: 23rpx; }
.status-columns > view > text:last-child { font-size: 35rpx; font-weight: 700; }
.status-columns text text { margin-left: 6rpx; font-size: 20rpx; font-weight: 400; color: #8a948d; }
.subject-row { margin: 24rpx 0; }
.subject-row > view:first-child { display: flex; justify-content: space-between; margin-bottom: 14rpx; font-size: 24rpx; }
.subject-row > view:first-child > text:last-child { color: #819087; font-size: 22rpx; }
.record-statistics { display: flex; }
.record-statistics > view { display: flex; width: 33.33%; flex-direction: column; gap: 8rpx; }
.record-statistics text:first-child { font-size: 38rpx; font-weight: 700; }
.record-statistics text:last-child { color: #829087; font-size: 21rpx; }
