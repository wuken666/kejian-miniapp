.profile-page { background: #fff; min-height: 100vh; color: #282923; }
.profile-page form { display: block; width: 100%; padding-top: 48rpx; }
.profile-identity { display: flex; align-items: center; gap: 24rpx; min-height: 190rpx; margin: 24rpx 0 36rpx; padding: 24rpx; background: #f7efec; border: 1rpx solid #eaded9; border-radius: 8px; box-sizing: border-box; }
.profile-portrait { width: 112rpx; height: 112rpx; border-radius: 50%; flex: 0 0 112rpx; }
.initial { display: flex; align-items: center; justify-content: center; background: #e8d4c9; color: #934b36; font-size: 42rpx; }
.identity-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; overflow-wrap: anywhere; }
.identity-copy text:first-child { font-size: 34rpx; font-weight: 700; }
.identity-copy text:last-child { color: #8b7770; font-size: 24rpx; }
.row-arrow { margin-left: auto; width: 28rpx; height: 28rpx; flex: 0 0 28rpx; }
.settings-heading { display: block; margin: 40rpx 0 14rpx; font-size: 28rpx; font-weight: 700; }
.settings-row { display: flex; align-items: center; gap: 22rpx; min-height: 108rpx; border-bottom: 1rpx solid #eee9e6; font-size: 28rpx; }
.setting-icon { display: flex; align-items: center; justify-content: center; background: #f6eeea; width: 62rpx; height: 62rpx; border-radius: 8rpx; }
.setting-icon image { width: 34rpx; height: 34rpx; }
.profile-account-actions, .edit-cancel { text-align: center; padding: 28rpx; margin-top: 40rpx; color: #a84c40; font-size: 26rpx; }
.profile-brand { display: block; text-align: center; color: #b3a49c; font-size: 22rpx; margin: 30rpx 0; }
.profile-edit-heading { text-align: center; margin: 40rpx 0; font-size: 32rpx; font-weight: 700; }
button.avatar-picker { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 180rpx; min-width: 180rpx; max-width: 180rpx; height: 180rpx; min-height: 180rpx; max-height: 180rpx; aspect-ratio: 1; margin: 0 auto; padding: 0; overflow: visible; border-radius: 50%; background: #f2e5de; color: #a34e36; font-size: 60rpx; line-height: 1; }
.avatar-picker::after { border: 2rpx solid #d8af98; border-radius: 50%; }
.avatar-picker > image { width: 100%; height: 100%; border-radius: 50%; }
.avatar-edit { position: absolute; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 50%; background: #a34e36; border: 4rpx solid #fff; }
.avatar-edit image { width: 28rpx; height: 28rpx; }
.avatar-caption { display: block; text-align: center; margin: 28rpx 0 60rpx; color: #a34e36; font-size: 26rpx; }
.name-field text { display: block; color: #8a7e77; font-size: 25rpx; margin-bottom: 20rpx; }
.name-field input { height: 88rpx; padding: 0 24rpx; background: #f6f4f3; border-radius: 8rpx; font-size: 30rpx; }
button.profile-save { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 100%; height: 96rpx; min-height: 96rpx; margin: 48rpx 0 0; padding: 20rpx 24rpx; background: #a34e36; color: #fff; font-size: 28rpx; line-height: 1.5; border-radius: 8rpx; }
.profile-error { color: #a84c40; padding: 24rpx 0; font-size: 26rpx; }
